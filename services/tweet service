package main

import (
	"context"
	"fmt"
	"log"
	"mime/multipart"
	"net/http"
	"os"
	"time"

	"github.com/aws/aws-sdk-go/aws"
	"github.com/aws/aws-sdk-go/aws/session"
	"github.com/aws/aws-sdk-go/service/dynamodb"
	"github.com/aws/aws-sdk-go/service/s3"
)

var (
	dynamoDB *dynamodb.DynamoDB
	s3Svc    *s3.S3
	ctx      = context.Background()
)

func init() {
	// Initialize AWS Session
	sess := session.Must(session.NewSession())

	// DynamoDB Client
	dynamoDB = dynamodb.New(sess)

	// S3 Client
	s3Svc = s3.New(sess)
}

type Tweet struct {
	ID         string `json:"id"`
	UserID     string `json:"user_id"`
	Content    string `json:"content"`
	Timestamp  string `json:"timestamp"`
	Attachment string `json:"attachment,omitempty"`
}

func uploadFileToS3(file multipart.File, fileName string) (string, error) {
	bucketName := os.Getenv("S3_BUCKET_NAME")

	// Upload the file to S3
	_, err := s3Svc.PutObject(&s3.PutObjectInput{
		Bucket: aws.String(bucketName),
		Key:    aws.String(fileName),
		Body:   file,
		ACL:    aws.String("public-read"),
	})
	if err != nil {
		return "", fmt.Errorf("failed to upload file to S3: %w", err)
	}

	// Construct the S3 object URL
	fileURL := fmt.Sprintf("https://%s.s3.amazonaws.com/%s", bucketName, fileName)
	return fileURL, nil
}

func createTweetHandler(w http.ResponseWriter, r *http.Request) {
	// Parse form data (for file upload)
	if err := r.ParseMultipartForm(10 << 20); err != nil {
		http.Error(w, "Failed to parse form", http.StatusBadRequest)
		return
	}

	tweet := Tweet{
		ID:        r.FormValue("id"),
		UserID:    r.FormValue("user_id"),
		Content:   r.FormValue("content"),
		Timestamp: time.Now().Format(time.RFC3339),
	}

	// Handle media attachment upload
	file, handler, err := r.FormFile("attachment")
	if err == nil {
		defer file.Close()
		fileURL, err := uploadFileToS3(file, "tweets/"+handler.Filename)
		if err != nil {
			http.Error(w, "Failed to upload attachment", http.StatusInternalServerError)
			return
		}
		tweet.Attachment = fileURL
	}

	// Save tweet data in DynamoDB
	_, err = dynamoDB.PutItem(&dynamodb.PutItemInput{
		TableName: aws.String("Tweets"),
		Item: map[string]*dynamodb.AttributeValue{
			"ID":         {S: aws.String(tweet.ID)},
			"UserID":     {S: aws.String(tweet.UserID)},
			"Content":    {S: aws.String(tweet.Content)},
			"Timestamp":  {S: aws.String(tweet.Timestamp)},
			"Attachment": {S: aws.String(tweet.Attachment)},
		},
	})
	if err != nil {
		http.Error(w, "Failed to save tweet", http.StatusInternalServerError)
		return
	}

	w.WriteHeader(http.StatusCreated)
	fmt.Fprintln(w, "Tweet created successfully")
}

func main() {
	http.HandleFunc("/tweets", createTweetHandler)
	log.Fatal(http.ListenAndServe(":8081", nil))
}
